# --- Browser (exposed to the client) ---
VITE_CIRCLE_APP_ID=
VITE_GOOGLE_CLIENT_ID=     # Google OAuth web client id (optional; shows "Continue with Google")
VITE_ARC_EXPLORER_URL=https://explorer.testnet.arc.io

# --- Server only ---
CIRCLE_API_KEY=
SESSION_SECRET=            # long random string, e.g. `openssl rand -base64 48`
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

ARC_RPC_URL=https://rpc.testnet.arc.network
ESCROW_ADDRESS=            # ArcHuntEscrow deployed on Arc Testnet
ARBITER_PRIVATE_KEY=       # server wallet allowed to auto-accept / resolve disputes; needs a little USDC for gas

ADMIN_CIRCLE_USER_IDS=     # comma-separated Circle user ids (emails are not verified by Circle, so they are never used for roles)
CRON_SECRET=               # Vercel sends it as `Authorization: Bearer <CRON_SECRET>`
