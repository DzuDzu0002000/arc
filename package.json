{
  "name": "bugline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -p tsconfig.app.json && tsc -p tsconfig.api.json && vite build",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.api.json",
    "test": "node --test \"tests/*.test.ts\"",
    "contracts:compile": "node scripts/compile-contracts.mjs",
    "contracts:deploy": "node scripts/deploy-escrow.mjs"
  },
  "dependencies": {
    "@circle-fin/w3s-pw-web-sdk": "1.1.11",
    "@supabase/supabase-js": "2.115.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@ethereumjs/block": "^10.1.3",
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vercel/node": "12.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "solc": "0.8.24",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-node-polyfills": "0.28.0"
  }
}
